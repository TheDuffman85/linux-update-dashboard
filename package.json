{
  "name": "linux-update-dashboard",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.9.1"
  },
  "scripts": {
    "dev": "APP_VERSION=dev-$(date -u +'%Y%m%d%H%M'); VITE_APP_VERSION=\"$APP_VERSION\" LUDASH_APP_VERSION=\"$APP_VERSION\" tsx watch server/index.ts & VITE_APP_VERSION=\"$APP_VERSION\" LUDASH_APP_VERSION=\"$APP_VERSION\" vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "generate:eol": "node scripts/generate-distro-lifecycle-data.mjs",
    "prebuild": "node scripts/generate-distro-lifecycle-data.mjs",
    "build": "vite build && tsup",
    "start": "node dist/server/index.js",
    "screenshots": "screenshots/create-screenshots.sh",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@simplewebauthn/server": "^14.0.3",
    "@types/sortablejs": "^1.15.9",
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.0.3",
    "croner": "^10.0.1",
    "cronstrue": "^3.27.0",
    "drizzle-orm": "^0.45.3",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.13",
    "i18next": "^26.4.2",
    "jose": "^6.2.12",
    "mqtt": "^5.16.0",
    "mustache": "^4.2.0",
    "nodemailer": "^10.0.14",
    "openid-client": "^6.8.8",
    "otplib": "^13.5.0",
    "prettier": "^3.9.9",
    "prettier-plugin-sh": "^0.20.2",
    "qrcode": "^1.5.4",
    "react-i18next": "^17.0.15",
    "sortablejs": "^1.15.7",
    "ssh2": "^1.17.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
