Defaults:testuser !requiretty
Defaults:testuser env_keep += "DEBGET_TOKEN"

# APT check commands, so APT and deb-get run side by side.
testuser ALL=(root) NOPASSWD: /usr/bin/dpkg --audit
testuser ALL=(root) NOPASSWD: /usr/bin/apt-get -o DPkg\:\:Lock\:\:Timeout\=60 update -qq

# deb-get, as generated by the dashboard's sudoers setup (selected-package
# install uncommented).
testuser ALL=(root) NOPASSWD: /usr/local/bin/deb-get upgrade --dg-only
testuser ALL=(root) NOPASSWD: /usr/local/bin/deb-get show *
testuser ALL=(root) NOPASSWD: /usr/local/bin/deb-get install *

# Test-only helper that resets fixture versions.
testuser ALL=(root) NOPASSWD: /opt/deb-get-fixture/reset-fixtures.sh ""
