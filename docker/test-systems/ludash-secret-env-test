#!/bin/sh
# Reports what a root command sees of the secret environment variable that the
# dashboard delivers over stdin and passes through sudo via env_keep.
set -eu
token="${SECRET_ENV_TEST_TOKEN-}"
printf 'uid=%s\n' "$(id -u)"
printf 'len=%s\n' "${#token}"
printf 'sha256=%s\n' "$(printf '%s' "$token" | sha256sum | cut -d' ' -f1)"
printf 'token=%s\n' "$token"
